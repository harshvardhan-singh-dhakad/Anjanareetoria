Options -MultiViews
RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------------------
# 1. PREVENT INFINITE REDIRECT LOOPS ON HOSTINGER / CLOUDFLARE
# ------------------------------------------------------------------------------
# Hostinger and Cloudflare terminate SSL at the proxy. We must check X-Forwarded-Proto
# to avoid infinite 301 redirect loops causing "This site can't be reached".
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP:CF-Visitor} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------------------------
# 2. SERVE EXISTING FILES & ASSETS DIRECTLY
# ------------------------------------------------------------------------------
# (_next/ chunks, images, css, favicon, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ------------------------------------------------------------------------------
# 3. CLEAN EXTENSIONLESS URL ROUTING (Fixes 404 on Refresh)
# ------------------------------------------------------------------------------
# If /books is requested, check if books.html exists on disk
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# If /books/ or directory is requested, check for index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# If URL has trailing slash but matching .html file exists, serve it
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ %1.html [L]

# ------------------------------------------------------------------------------
# 4. CUSTOM 404 ERROR PAGE
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html
