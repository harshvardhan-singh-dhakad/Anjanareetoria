DirectoryIndex index.html index.php
Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------------------
# 1. PREVENT INFINITE HTTPS REDIRECT LOOP ON HOSTINGER / CLOUDFLARE
# ------------------------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP:CF-Visitor} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------------------------
# 2. EXPLICIT ROOT ROUTE
# ------------------------------------------------------------------------------
RewriteRule ^$ index.html [L]

# ------------------------------------------------------------------------------
# 3. EXISTING STATIC ASSETS (css, js, images, videos, fonts)
# ------------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ------------------------------------------------------------------------------
# 4. EXTENSIONLESS URL ROUTING (Fixes 403 Forbidden on /books, /blog, /webinars)
#    When /books or /blog is requested, serve books.html or blog.html directly
#    even if a directory named "books" or "blog" exists.
# ------------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ------------------------------------------------------------------------------
# 5. IF DIRECTORY CONTAINS AN INDEX.HTML FILE, SERVE IT
# ------------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# ------------------------------------------------------------------------------
# 6. CUSTOM 404 ERROR PAGE
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html
