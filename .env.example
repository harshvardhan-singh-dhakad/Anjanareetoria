# ==============================================================================
# AR BLESSINGS ENVIRONMENT VARIABLES CONFIGURATION (VPS / Production)
# ==============================================================================

# Private E-Book Storage Directory (Outside public web root)
# On Hostinger VPS, recommend: /var/app/private-ebooks
EBOOK_STORAGE_PATH=./private-ebooks

# JWT Secret for Session and Stream Tokens (Generate a long random string in production)
EBOOK_JWT_SECRET=arblessings-vps-ebook-secret-key-2024-secure

# Optional Database Connection Strings
# MongoDB (Atlas or Local VPS)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/arblessings
# MONGODB_URI=mongodb://127.0.0.1:27017/arblessings

# SQL (MySQL / PostgreSQL via Prisma)
# DATABASE_URL=mysql://arb_user:password@localhost:3306/arblessings
